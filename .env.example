# Required Telegram secret. Never commit the real .env.
BOT_TOKEN=
# AI can explicitly be disabled; cached materials/history remain available.
AI_ENABLED=true
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
# Trusted root CA PEM, relative to project root or absolute. TLS is always verified.
GIGACHAT_CA_BUNDLE_FILE=
# Optional proxy for Telegram only (GigaChat connects directly).
PROXY_URL=
# Support is unavailable if ADMIN_ID=0 or SUPPORT_ENABLED=false.
ADMIN_ID=0
SUPPORT_ENABLED=true
SUPPORT_COOLDOWN_SECONDS=300
# Local defaults are relative to the PROJECT root, not the current working directory.
# Amvera: UPLOAD_DIR=/data/uploads and DATABASE_PATH=/data/bot.sqlite3
UPLOAD_DIR=files
DATABASE_PATH=data/bot.sqlite3
# 20 MiB maximum for the standard cloud Telegram Bot API (also within GigaChat's limit).
MAX_UPLOAD_BYTES=20971520
MAX_USER_FILES=20
MAX_USER_BYTES=104857600
RETENTION_DAYS=30
QUEUE_SIZE=10
GENERATION_WORKERS=1
# New jobs per user per UTC day; cached results do not count.
DAILY_GENERATION_LIMIT=10
QUEUE_TIMEOUT_SECONDS=300
GENERATION_TIMEOUT_SECONDS=240
UPLOAD_TIMEOUT_SECONDS=90
HTTP_TIMEOUT_SECONDS=90
CLEANUP_INTERVAL_SECONDS=3600
ORPHAN_GRACE_SECONDS=3600
LOG_LEVEL=INFO
